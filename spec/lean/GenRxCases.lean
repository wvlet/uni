import UniSpec.Rx

/-!
Writes `RxSpecCases.scala`: the expected output of every small pipeline over every small input,
evaluated from the model in `UniSpec/Rx.lean`. `RxSpecTest` replays the cases through `RxRunner`.

Usage: `lake exe gen-rx-cases [output path]`
-/

open UniSpec.Rx

inductive Op where
  | even
  | take (n : Nat)
  | times10

def Op.apply : Op → List Event → List Event
  | .even => UniSpec.Rx.filter (fun v => v % 2 == 0)
  | .take n => UniSpec.Rx.take n
  | .times10 => UniSpec.Rx.map (· * 10)

def Op.render : Op → String
  | .even => "even"
  | .take n => s!"take:{n}"
  | .times10 => "x10"

def renderEvent : Event → String
  | .next v => toString v
  | .done => "C"
  | .fail => "E"

def renderList {α} (f : α → String) : List α → String
  | [] => "-"
  | xs => " ".intercalate (xs.map f)

def ops : List Op := [.even, .take 0, .take 1, .take 2, .times10]

def pipelines : List (List Op) :=
  ops.map (fun o => [o]) ++ ops.flatMap (fun a => ops.map (fun b => [a, b]))

def inputs : List (List Event) :=
  let valueLists : List (List Int) := [[], [1], [1, 2, 3], [2, 4, 6]]
  -- Completion, error, silence, and an event after completion that the source must not deliver
  let endings : List (List Event) := [[.done], [.fail], [], [.done, .next 9]]
  valueLists.flatMap (fun vs => endings.map (fun e => nexts vs ++ e))

def runPipeline (pipeline : List Op) (input : List Event) : List Event :=
  pipeline.foldl (fun s op => op.apply s) (observe input)

def caseLine (pipeline : List Op) (input : List Event) : String :=
  s!"    \"{renderList renderEvent input} | {renderList Op.render pipeline} | " ++
    s!"{renderList renderEvent (runPipeline pipeline input)}\""

def scalaSource : String :=
  -- Formatted as scalafmt would, so the Code format check passes on the generated file
  let lines := pipelines.flatMap (fun p => inputs.map (caseLine p))
  "\n".intercalate ([
    "// Generated by `lake exe gen-rx-cases` in spec/lean from UniSpec/Rx.lean. Do not edit.",
    "package wvlet.uni.rx",
    "",
    "object RxSpecCases:",
    "  // Each case: input events | operators | expected events.",
    "  // Events: an Int for OnNext, C for OnCompletion, E for OnError; - for none.",
    "  val cases: Seq[String] = Seq("
  ] ++ [",\n".intercalate lines, "  )", "", "end RxSpecCases", ""])

def defaultOutput : System.FilePath :=
  "../../uni/src/test/scala/wvlet/uni/rx/RxSpecCases.scala"

def main (args : List String) : IO Unit := do
  let out := args.head?.map System.FilePath.mk |>.getD defaultOutput
  IO.FS.writeFile out scalaSource
  IO.println s!"Wrote {pipelines.length * inputs.length} cases to {out}"
