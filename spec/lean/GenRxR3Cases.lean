import UniSpec.RxR3Ops

/-!
Writes `RxR3SpecCases.scala`: the expected output of small pipelines under the target event model
of `UniSpec/RxR3.lean` and `UniSpec/RxR3Ops.lean`, where `OnError` never ends a stream and
`OnCompletion` (success or failure) is the only end. `RxR3SpecTest` replays the cases through
`RxRunner.runContinuously`.

Usage: `lake exe gen-rx-r3-cases [output path]`
-/

open UniSpec.RxR3

def renderEvent : REvent → String
  | .next v => toString v
  | .resume => "E"
  | .done => "C"
  | .failed => "F"

def renderTrace : List REvent → String
  | [] => "-"
  | es => " ".intercalate (es.map renderEvent)

/-- Operators by the name `RxR3SpecTest` builds them from. -/
def ops : List (String × (List REvent → List REvent)) :=
  [ ("even", (Op.filter (fun v => v % 2 == 0)).r3),
    ("take:2", take 2),
    ("inc", (Op.map (· + 1)).r3),
    ("boom:2", (Op.boom 2).r3),
    ("rec:0", recover 0) ]

def pipelines : List (List (String × (List REvent → List REvent))) :=
  ops.map (fun o => [o]) ++ ops.flatMap (fun a => ops.map (fun b => [a, b])) ++
    ops.map (fun a => [a, ("rec:0", recover 0), ("boom:0", (Op.boom 0).r3)])

/-- Inputs: a source may report `OnError` and continue, and events after its end are dropped. -/
def inputs : List (List REvent) :=
  [ [.next 1, .next 2, .next 3, .done],
    [.next 1, .next 2, .next 3, .failed],
    [.next 1, .next 2, .next 3],
    [.next 1, .resume, .next 2, .done],
    [.next 2, .done, .next 3],
    [.next 1, .failed, .next 2, .done],
    [.resume, .next 2, .resume, .next 4, .done],
    [.done],
    [] ]

def caseLines : List String :=
  pipelines.flatMap fun p =>
    inputs.map fun input =>
      let names := " ".intercalate (p.map (·.1))
      let out := observe (applyAll (p.map (·.2)) input)
      s!"    \"{renderTrace input} | {names} | {renderTrace out}\""

-- Formatted as scalafmt would, so the Code format check passes on the generated file
def scalaSource : String :=
  "\n".intercalate ([
    "// Generated by `lake exe gen-rx-r3-cases` in spec/lean from UniSpec/RxR3Ops.lean. Do not edit.",
    "package wvlet.uni.rx",
    "",
    "object RxR3SpecCases:",
    "  // Each case: input events | operators | expected events.",
    "  // Events: an Int for OnNext, E for OnError, C for a successful OnCompletion, F for a failed",
    "  // OnCompletion; - for none.",
    "  val cases: Seq[String] = Seq("
  ] ++ [",\n".intercalate caseLines, "  )", "", "end RxR3SpecCases", ""])

def defaultOutput : System.FilePath :=
  "../../uni/src/test/scala/wvlet/uni/rx/RxR3SpecCases.scala"

def main (args : List String) : IO Unit := do
  let out := args.head?.map System.FilePath.mk |>.getD defaultOutput
  IO.FS.writeFile out scalaSource
  IO.println s!"Wrote {caseLines.length} cases to {out}"
