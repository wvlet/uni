import UniSpec.RxNested

/-!
Writes `RxNestedSpecCases.scala`: the expected output of `concat`, `merge`, and `flatMap` over small
synchronous inputs, evaluated from the model in `UniSpec/RxNested.lean`. `RxNestedSpecTest` replays
the cases through `RxRunner`.

Usage: `lake exe gen-rx-nested-cases [output path]`
-/

open UniSpec.Rx

def renderEvent : Event → String
  | .next v => toString v
  | .done => "C"
  | .fail => "E"

def renderTrace : List Event → String
  | [] => "-"
  | es => " ".intercalate (es.map renderEvent)

def renderSources (ts : List (List Event)) : String := " / ".intercalate (ts.map renderTrace)

/-- Values, each followed by completion, an error, or silence. -/
def inputsWith (valueLists : List (List Int)) : List (List Event) :=
  let endings : List (List Event) := [[.done], [.fail], []]
  valueLists.flatMap fun vs => endings.map fun e => vs.map .next ++ e

def inputs : List (List Event) := inputsWith [[], [1], [1, 2]]

/-- The nested streams of `flatMap`, named as `RxNestedSpecTest` builds them. -/
def nested : List (String × (Int → List Event)) :=
  [ ("dup", fun x => [.next x, .next (x * 10), .done]),
    ("open", fun x => [.next x]),
    ("failOdd", fun x => if x % 2 == 1 then [.next x, .fail] else [.next x, .done]),
    ("empty", fun _ => [.done]) ]

def line (op : String) (sources : List (List Event)) (out : List Event) : String :=
  s!"    \"{op} | {renderSources sources} | {renderTrace out}\""

def caseLines : List String :=
  let pairs := inputs.flatMap fun a => inputs.map fun b => [a, b]
  -- One value per source, so a triple's output shows the subscription order
  let triples :=
    let ts := [[.next 1, .done], [.next 2, .fail], [.next 3]]
    ts.flatMap fun a => ts.flatMap fun b => ts.map fun c => [a, b, c]
  pairs.map (fun p => line "concat" p (concat p[0]! p[1]!)) ++
  [line "merge" [] (merge [])] ++
  inputs.map (fun t => line "merge" [t] (merge [t])) ++
  (pairs ++ triples).map (fun ts => line "merge" ts (merge ts)) ++
  nested.flatMap fun (name, f) =>
    inputs.map fun t => line s!"flatMap:{name}" [t] (flatMap f t)

-- Formatted as scalafmt would, so the Code format check passes on the generated file
def scalaSource : String :=
  "\n".intercalate ([
    "// Generated by `lake exe gen-rx-nested-cases` in spec/lean from UniSpec/RxNested.lean. Do not edit.",
    "package wvlet.uni.rx",
    "",
    "object RxNestedSpecCases:",
    "  // Each case: operator | sources separated by / | expected events.",
    "  // Events: an Int for OnNext, C for OnCompletion, E for OnError; - for none.",
    "  val cases: Seq[String] = Seq("
  ] ++ [",\n".intercalate caseLines, "  )", "", "end RxNestedSpecCases", ""])

def defaultOutput : System.FilePath :=
  "../../uni/src/test/scala/wvlet/uni/rx/RxNestedSpecCases.scala"

def main (args : List String) : IO Unit := do
  let out := args.head?.map System.FilePath.mk |>.getD defaultOutput
  IO.FS.writeFile out scalaSource
  IO.println s!"Wrote {caseLines.length} cases to {out}"
