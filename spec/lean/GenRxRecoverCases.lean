import UniSpec.RxRecover

/-!
Writes `RxRecoverSpecCases.scala`: the expected output of small pipelines with `recover` and a
throwing `map`, in default and continuous mode, evaluated from the model in
`UniSpec/RxRecover.lean`. `RxRecoverSpecTest` replays the cases through `RxRunner`.

Usage: `lake exe gen-rx-recover-cases [output path]`
-/

open UniSpec.Rx

def renderEvent : Event → String
  | .next v => toString v
  | .done => "C"
  | .fail => "E"

def renderTrace : List Event → String
  | [] => "-"
  | es => " ".intercalate (es.map renderEvent)

/-- Operators by the name `RxRecoverSpecTest` builds them from. -/
def ops : List (String × (List Event → List Event)) :=
  [ ("even", filterE (fun v => v % 2 == 0)),
    ("take:2", take 2),
    ("inc", mapE (· + 1)),
    ("boom:2", boomE 2),
    ("rec:0", recoverE 0) ]

def pipelines : List (List (String × (List Event → List Event))) :=
  ops.map (fun o => [o]) ++ ops.flatMap (fun a => ops.map (fun b => [a, b]))

/-- Inputs, including events after a terminal one, which only continuous mode delivers. -/
def inputs : List (List Event) :=
  [ [.next 1, .next 2, .next 3, .done],
    [.next 1, .next 2, .next 3, .fail],
    [.next 1, .next 2, .next 3],
    [.next 1, .fail, .next 2, .done],
    [.next 2, .done, .next 3],
    [.fail, .next 2, .fail, .next 4, .done],
    [.done],
    [] ]

def modes : List (String × Mode) := [("default", .default), ("continuous", .continuous)]

def caseLines : List String :=
  modes.flatMap fun (modeName, mode) =>
    pipelines.flatMap fun p =>
      inputs.map fun input =>
        let names := " ".intercalate (p.map (·.1))
        let out := run mode (p.map (·.2)) input
        s!"    \"{modeName} | {renderTrace input} | {names} | {renderTrace out}\""

-- Formatted as scalafmt would, so the Code format check passes on the generated file
def scalaSource : String :=
  "\n".intercalate ([
    "// Generated by `lake exe gen-rx-recover-cases` in spec/lean from UniSpec/RxRecover.lean. Do not edit.",
    "package wvlet.uni.rx",
    "",
    "object RxRecoverSpecCases:",
    "  // Each case: mode | input events | operators | expected events.",
    "  // Events: an Int for OnNext, C for OnCompletion, E for OnError; - for none.",
    "  val cases: Seq[String] = Seq("
  ] ++ [",\n".intercalate caseLines, "  )", "", "end RxRecoverSpecCases", ""])

def defaultOutput : System.FilePath :=
  "../../uni/src/test/scala/wvlet/uni/rx/RxRecoverSpecCases.scala"

def main (args : List String) : IO Unit := do
  let out := args.head?.map System.FilePath.mk |>.getD defaultOutput
  IO.FS.writeFile out scalaSource
  IO.println s!"Wrote {caseLines.length} cases to {out}"
