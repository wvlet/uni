# The native server needs libc (and libgcc/libstdc++ for unwinding), which distroless/cc provides,
# plus zlib, copied from the build machine by build.sh (and libgc for a UNI_NATIVE_GC=boehm build;
# the glob copies whichever exist). Debian 13's glibc is newer than the Ubuntu 24.04 build
# machine's, so the binary and the libraries run.
FROM gcr.io/distroless/cc-debian13:nonroot
COPY out/lib*.so.1 /usr/lib/
COPY out/rpc-native /rpc-native
# A 64 MB starting heap; Immix and Boehm both read GC_INITIAL_HEAP_SIZE
# (see the example README, "Garbage collector")
ENV GC_INITIAL_HEAP_SIZE=64m
EXPOSE 8080
ENTRYPOINT ["/rpc-native", "8080", "0.0.0.0"]
