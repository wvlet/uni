# The native server needs libc (and libgcc/libstdc++ for unwinding), which distroless/cc provides,
# plus the Boehm GC library, copied from the build machine by build.sh. Debian 13's glibc is newer
# than the Ubuntu 24.04 build machine's, so the binary and libgc run.
FROM gcr.io/distroless/cc-debian13:nonroot
COPY out/libgc.so.1 /usr/lib/libgc.so.1
COPY out/rpc-native /rpc-native
EXPOSE 8080
ENTRYPOINT ["/rpc-native", "8080", "0.0.0.0"]
